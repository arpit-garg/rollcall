POSTGRES_DB=hostel_attendance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/hostel_attendance
REDIS_URL=redis://redis:6379

JWT_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=face-templates

ML_SERVICE_URL=http://ml-service:8000
FACE_SIMILARITY_THRESHOLD=0.75
LIVENESS_THRESHOLD=0.80
MAX_ATTEMPTS_PER_WINDOW=3
ATTENDANCE_IDEMPOTENCY_NAMESPACE=attendance:idempotency
VERIFICATION_QUEUE_NAME=attendance:verification:queue
ENABLE_VERIFICATION_WORKER=true

AUTH_SERVICE_PORT=3001
ATTENDANCE_SERVICE_PORT=3002
ML_SERVICE_PORT=8000
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

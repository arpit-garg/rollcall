{
  "name": "hostel-attendance",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down -v",
    "check:auth": "node --check services/auth-service/src/server.js",
    "check:attendance": "node --check services/attendance-service/src/server.js",
    "check:dashboard": "npm run build --prefix admin-dashboard",
    "check:ml": "python -m compileall services/ml-service/app",
    "check": "npm run check:auth && npm run check:attendance && npm run check:dashboard && npm run check:ml",
    "test:auth": "npm test --prefix services/auth-service",
    "test:attendance": "npm test --prefix services/attendance-service"
  }
}

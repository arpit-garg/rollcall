{
  "name": "hostel-attendance",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down -v",
    "check:auth": "node --check services/auth-service/src/server.js",
    "check:attendance": "node --check services/attendance-service/src/server.js",
    "check:ml": "python -m compileall services/ml-service/app",
    "check": "npm run check:auth && npm run check:attendance && npm run check:ml"
  }
}
